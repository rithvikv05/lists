{
  "name": "lists-search-engine",
  "version": "1.0.0",
  "description": "High-performance standalone universal media search and metadata aggregation engine",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "build": "tsc",
    "start": "wrangler dev",
    "test": "node --import tsx --test test/*.test.ts",
    "eval:search": "node eval/search.mjs",
    "dev:catalog": "wrangler dev --config wrangler.catalog.local.toml",
    "catalog:migrate:local": "wrangler d1 migrations apply lists-catalog-local --local --config wrangler.catalog.local.toml"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "htmlparser2": "^12.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.158.0"
  }
}
